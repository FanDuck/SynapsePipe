# ─────────────────────────────────────────────────────────────
#  SynapsePipe — local-first AIGC workbench
#  Every variable below is optional. The app boots with SQLite
#  and a curated demo library with zero configuration.
# ─────────────────────────────────────────────────────────────

# Where SQLite + uploaded media live (default: ./data)
SYNAPSE_DATA_DIR=./data

# Long random string used to encrypt the provider API key at rest.
# If omitted, SynapsePipe generates data/.secret on first launch.
# Example: openssl rand -hex 32
SYNAPSE_SECRET=

# Optional LLM bootstrap values, used only on the very first launch.
# You can also configure everything from Settings inside the app.
SYNAPSE_LLM_BASE_URL=https://api.deepseek.com/v1
SYNAPSE_LLM_API_KEY=
SYNAPSE_LLM_MODEL=deepseek-chat

# Disable the curated demo prompts/assets on first launch.
SYNAPSE_DISABLE_DEMO_SEED=0

# Public URL used for Open Graph metadata.
NEXT_PUBLIC_APP_URL=http://localhost:3000
